APP_ENV=local
APP_HOST_PORT=8000
# Your host user, so files WordPress writes to the mount are owned by you (id -u / id -g).
APP_UID=1000
APP_GID=1000

WP_HOME=http://localhost:8000

DB_HOST=db
DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=change-me-local-only
DB_ROOT_PASSWORD=change-me-local-only

# Generate real values with: openssl rand -base64 48
WP_AUTH_KEY=change-me-local-only
WP_SECURE_AUTH_KEY=change-me-local-only
WP_LOGGED_IN_KEY=change-me-local-only
WP_NONCE_KEY=change-me-local-only
WP_AUTH_SALT=change-me-local-only
WP_SECURE_AUTH_SALT=change-me-local-only
WP_LOGGED_IN_SALT=change-me-local-only
WP_NONCE_SALT=change-me-local-only
